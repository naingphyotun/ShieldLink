<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShieldLink" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/purple_primary</item>
    </style>
    <style name="Theme.ShieldLink.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/purple_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.ShieldLink</item>
    </style>
</resources>
